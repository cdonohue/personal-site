---
import Layout from '../../layouts/layout.astro';
import Stack from '../../components/Stack.astro';
import Heading from '../../components/Heading.astro';
import Text from '../../components/Text.astro';
import { Demo } from '../../labs/design-system/Demo';
import '../../labs/design-system/components/xray.css';
---

<Layout title="Design System Lab - Chad Donohue">
  <main>
    <Stack gap="section">
      <Stack gap="micro">
        <Heading level={1} size="lg">Design System Lab</Heading>
        <Text muted>Interactive x-ray mode for design system components</Text>
      </Stack>

      <Demo client:load />
    </Stack>
  </main>
</Layout>
