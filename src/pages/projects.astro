---
import Layout from '../layouts/layout.astro';
import Stack from '../components/Stack.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import Link from '../components/Link.astro';

const projects = [
  {
    name: 'Design System Toolkit',
    description: 'Token generation, component scaffolding, and documentation tooling.',
    url: '#',
  },
  {
    name: 'CLI Dashboard',
    description: 'Terminal-based project management with vim keybindings.',
    url: '#',
  },
  {
    name: 'Color Contrast Checker',
    description: 'WCAG compliance tool for design systems.',
    url: '#',
  },
];
---

<Layout title="Projects - Chad Donohue">
  <main>
    <Stack gap="section">
      <Stack gap="micro">
        <Heading level={1} size="lg">Projects</Heading>
        <Text muted>Things I've built</Text>
      </Stack>

      <Stack gap="layout">
        {projects.map(project => (
          <Stack gap="micro">
            <Heading level={2}>{project.name}</Heading>
            <Text>{project.description}</Text>
            <Link href={project.url}>View project →</Link>
          </Stack>
        ))}
      </Stack>
    </Stack>
  </main>
</Layout>
