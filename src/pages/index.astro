---
import Layout from '../layouts/layout.astro';
import Stack from '../components/Stack.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import Link from '../components/Link.astro';
import TerminalHero from '../components/TerminalHero.astro';
import employment from '../data/employment.json';

const current = employment.find(job => job.current);

const terminalLines = [
  "echo 'Hey, I'm Chad Donohue'",
  "cat role.txt # Design Engineer",
  "grep -r 'obsession' ./work # details, UX, craft",
  "history | tail -n1 # building for humans + LLMs",
];
---

<Layout title="Chad Donohue">
  <main>
    <Stack gap="section" class="content">
        <TerminalHero lines={terminalLines} />

        {current && (
          <Stack gap="standard">
            <Heading level={2} muted>Currently</Heading>
            <Stack gap="tight">
              <Heading level={3}>{current.role} at {current.company}</Heading>
              <Text>{current.description}</Text>
            </Stack>
            <Link href="/work">View full work history →</Link>
          </Stack>
        )}
      </Stack>
  </main>
</Layout>