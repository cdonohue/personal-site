---
import SiteHeader from '../components/SiteHeader.astro'
import '../styles.css'

interface Props {
  /** Appended to the site name in the tab. Omitted on the home page. */
  title?: string
  /** Page-specific summary for search results and link previews. */
  description?: string
}

const {
  title,
  description = 'Chad Donohue is a software engineer building thoughtful products, design systems, and frontend architecture.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `Chad Donohue — ${title}` : 'Chad Donohue'}</title>
    <script is:inline>
      /*
       * Apply a stored theme before anything paints, so choosing Night and
       * clicking through to another page never flashes Gallery first. The key
       * is the one `pixel-desk/theme.ts` owns, shared with the scene's light
       * switch.
       */
      try {
        const stored = localStorage.getItem('desk-room.theme')
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored)
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="site">
      <SiteHeader />
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>
