---
import { elsewhere, navigation } from '../../../content'
import Link from '../../../components/Link.astro'
import Icon from './Icon.astro'
import NavKeys from './NavKeys.astro'

/**
 * The wide-screen left column: the index as a stack of keys, then the
 * outbound links. Narrower than that, the index lives in the title bar (see
 * SiteHeader) and Elsewhere drops to the end of the page as a row of keys —
 * which is why the two are separate grid items.
 */
---

<section class="u-panel side-index">
  <header class="u-panel__head">
    <span class="u-label">Index</span>
    <span class="u-label">{String(navigation.length).padStart(2, '0')}</span>
  </header>
  <NavKeys />
</section>

<section class="u-panel side-else">
  <header class="u-panel__head">
    <span class="u-label">Elsewhere</span>
  </header>
  <div class="keylist">
    {
      elsewhere.map(({ label, href }) => (
        <Link href={href} class="keyrow">
          <span class="keyrow__label">{label}</span>
          <Icon name="arrow-right" />
        </Link>
      ))
    }
  </div>
</section>
