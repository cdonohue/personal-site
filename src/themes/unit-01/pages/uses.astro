---
import Layout from '../layouts/Layout.astro'
import Link from '../../../components/Link.astro'
import Icon from '../components/Icon.astro'
import { usesItems } from '../../../content'
import {
  ROOM_ITEM_EXPORTS,
  decorLayerPath,
  roomVariantPath,
  skyPath,
  usesItemPath,
} from '../../pixel-desk/scene/art'
import { DECOR_DEFINITIONS } from '../../pixel-desk/scene/decor'

/*
 * The map is built from the pixel desk's own exports — the same sky, desk and
 * decor layers the scene draws, and each product's item export as its hit
 * target — so it can never drift from the room file.
 */
const sceneUseIds = new Set(Object.keys(ROOM_ITEM_EXPORTS))
const sceneUses = usesItems.filter((item) => sceneUseIds.has(item.id))
const additionalUses = usesItems.filter((item) => !sceneUseIds.has(item.id))
const mapLayers = [
  `${skyPath('/art', 'clear-day')}.png`,
  `${roomVariantPath('/art', 'deskLegsInner')}.png`,
  `${roomVariantPath('/art', 'deskLegsMid')}.png`,
  `${roomVariantPath('/art', 'deskLegsFixed')}.png`,
  `${roomVariantPath('/art', 'deskTop')}.png`,
]
const decorLayers = Object.entries(DECOR_DEFINITIONS).flatMap(([decor, definition]) =>
  definition.layers.map(({ layer }) => ({
    decor,
    src: `${decorLayerPath('/art', layer)}.png`,
  })),
)
---

<Layout
  index="03"
  title="Uses"
  description="The hardware in Chad Donohue’s workspace, mapped to the interactive pixel desk scene."
>
  {/*
    The map is the page's centrepiece, set bare like the home page scene: the
    room drawn from its own exports, each piece of hardware a hit target cut
    from its item export.
  */}
  <figure class="scene" aria-labelledby="in-scene-title">
    <div class="uses-map-scene relative">
      <div class="uses-map-art absolute inset-0 overflow-hidden">
        {mapLayers.map((src) => <img src={src} alt="" class="uses-map-layer" />)}
        {decorLayers.map(({ decor, src }) => (
          <img
            src={src}
            alt=""
            class="uses-map-layer"
            data-uses-decor={decor}
            aria-hidden="true"
            hidden
          />
        ))}
      </div>
          <nav aria-label="Hardware in the pixel desk scene">
            {
              sceneUses.flatMap((item) => {
                const definition = ROOM_ITEM_EXPORTS[item.id as keyof typeof ROOM_ITEM_EXPORTS]
                const hasMultiplePlacements = 'targets' in definition
                const targets = hasMultiplePlacements ? definition.targets : [definition.crop]
                return targets.map(([x, y, width, height], index) => {
                  const placement = targets.length > 1 ? ` ${index === 0 ? 'left' : 'right'}` : ''
                  return (
                    <details
                      name="uses-map-item"
                      class={`uses-map-point ${y + height / 2 > 54 ? 'popover-top' : 'popover-bottom'}`}
                    >
                      <summary
                        class={`uses-map-marker ${hasMultiplePlacements ? 'uses-map-marker-instance' : ''}`}
                        style={`left: ${(x / 192) * 100}%; top: ${(y / 108) * 100}%; width: ${(width / 192) * 100}%; height: ${(height / 108) * 100}%; z-index: ${10000 - width * height};`}
                        aria-label={`${item.name}${placement} product details`}
                      >
                        <img
                          src={usesItemPath('/art', item.id)}
                          alt=""
                          class="uses-map-item"
                          aria-hidden="true"
                        />
                      </summary>
                      <div class="uses-map-popover">
                        <div class="uses-popover-head">
                          <span class="u-label">In the scene</span>
                          <button
                            type="button"
                            class="u-key u-key--sm"
                            aria-label={`Close ${item.name} details`}
                            data-close-uses-popover
                          >
                            <Icon name="close" />
                          </button>
                        </div>
                        <h4 class="item-title">{item.name}</h4>
                        <p class="muted small">{item.description}</p>
                        <Link href={item.href} class="uses-product-link">
                          View product <Icon name="arrow-right" />
                        </Link>
                      </div>
                    </details>
                  )
                })
              })
            }
          </nav>
    </div>
    <figcaption class="scene__caption">
      <h2 class="u-label" id="in-scene-title"><b>Uses</b> Select a piece of hardware</h2>
      <span class="u-label">{String(sceneUses.length).padStart(2, '0')} items</span>
    </figcaption>
  </figure>

  <div class="modules modules--2-1">
    <section class="u-panel" aria-labelledby="about-uses-title">
      <header class="u-panel__head">
        <h3 class="u-label" id="about-uses-title"><b>01</b> About</h3>
      </header>
      <p class="lead prose">
        This is the hardware behind both the pixel room and the workspace it represents. Click an
        object in the scene to see what it is; the few things that stay off-screen are listed here.
      </p>
    </section>

    <section class="u-panel" aria-labelledby="rotation-title">
      <header class="u-panel__head">
        <h3 class="u-label" id="rotation-title"><b>02</b> Also in rotation</h3>
        <span class="u-label">{String(additionalUses.length).padStart(2, '0')}</span>
      </header>
      <ul class="rows rows--compact">
        {
          additionalUses.map((item) => (
            <li class="row">
              <div class="row__name">
                <h4 class="row__title">
                  <Link href={item.href} class="row__link">
                    {item.name}
                    <Icon name="arrow-right" />
                  </Link>
                </h4>
              </div>
              <p class="row__text muted">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<script>
  import { decorFromSearch, resolveDecor } from '../../pixel-desk/scene/decor'

  const decor = resolveDecor(new Date(), decorFromSearch(window.location.search))
  const visibleDecor = new Set<string>()
  Object.values(decor).forEach((item) => {
    if (item) visibleDecor.add(item)
  })
  document.querySelectorAll<HTMLElement>('[data-uses-decor]').forEach((layer) => {
    layer.hidden = !visibleDecor.has(layer.dataset.usesDecor ?? '')
  })

  document.querySelectorAll<HTMLButtonElement>('[data-close-uses-popover]').forEach((button) => {
    button.addEventListener('click', () => button.closest('details')?.removeAttribute('open'))
  })
</script>

<style>
  .uses-map-scene,
  .uses-map-art {
    aspect-ratio: 192 / 108;
  }

  .uses-map-scene {
    container-type: inline-size;
  }

  /* The same one-pixel stepped corner the home page scene uses. */
  .uses-map-art {
    background: #a0a0a0;
    clip-path: polygon(
      8px 0,
      calc(100% - 8px) 0,
      calc(100% - 8px) 8px,
      100% 8px,
      100% calc(100% - 8px),
      calc(100% - 8px) calc(100% - 8px),
      calc(100% - 8px) 100%,
      8px 100%,
      8px calc(100% - 8px),
      0 calc(100% - 8px),
      0 8px,
      8px 8px
    );
  }

  .uses-map-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  .uses-map-point {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .uses-map-point[open] {
    z-index: 20000;
  }

  /* Hover and focus outline the object in signal, one scene pixel thick. */
  .uses-map-marker {
    --scene-pixel: 0.5208333333cqw;

    position: absolute;
    border: 0;
    background: transparent;
    cursor: pointer;
    list-style: none;
    pointer-events: auto;
  }

  .uses-map-marker::before {
    position: absolute;
    inset: -0.3rem;
    content: '';
  }

  .uses-map-marker-instance::before {
    inset: -0.3rem 0 0;
  }

  .uses-map-marker-instance::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 400%;
    outline: var(--scene-pixel) solid var(--signal);
    opacity: 0;
    pointer-events: none;
    content: '';
  }

  .uses-map-item {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    image-rendering: pixelated;
  }

  .uses-map-marker::-webkit-details-marker {
    display: none;
  }

  .uses-map-marker:focus-visible {
    outline: none;
  }

  .uses-map-marker:hover .uses-map-item,
  .uses-map-marker:focus-visible .uses-map-item,
  .uses-map-point[open] .uses-map-item {
    opacity: 1;
    filter:
      drop-shadow(var(--scene-pixel) 0 0 var(--signal))
      drop-shadow(calc(-1 * var(--scene-pixel)) 0 0 var(--signal))
      drop-shadow(0 var(--scene-pixel) 0 var(--signal))
      drop-shadow(0 calc(-1 * var(--scene-pixel)) 0 var(--signal));
  }

  .uses-map-marker-instance:hover,
  .uses-map-marker-instance:focus-visible,
  .uses-map-point[open] .uses-map-marker-instance {
    outline: none;
  }

  .uses-map-marker-instance:hover::after,
  .uses-map-marker-instance:focus-visible::after,
  .uses-map-point[open] .uses-map-marker-instance::after {
    opacity: 1;
  }

  .uses-map-marker-instance:hover .uses-map-item,
  .uses-map-marker-instance:focus-visible .uses-map-item,
  .uses-map-point[open] .uses-map-marker-instance .uses-map-item {
    opacity: 0;
    filter: none;
  }

  /*
   * The popover sits on the wall colour and opens with a 2px rule, like every
   * other module. A hairline edge separates it from the art; no shadow, since
   * the keycap edge is the only shadow the system has.
   */
  .uses-map-popover {
    position: absolute;
    z-index: 2;
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: min(24rem, calc(100% - 2rem));
    padding: var(--space-2) var(--space-4) var(--space-4);
    transform: translateX(-50%);
    border: 1px solid var(--line);
    border-top: 2px solid var(--rule);
    background: var(--chassis);
    color: var(--ink);
    font-family: var(--font-sans);
    pointer-events: auto;
  }

  .uses-popover-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .popover-top .uses-map-popover {
    top: 1rem;
  }

  .popover-bottom .uses-map-popover {
    bottom: 1rem;
  }

  :global(.uses-product-link) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: var(--space-2);
    color: var(--ink);
    font: 700 11px / 14px var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  :global(.uses-product-link:hover) {
    background: var(--signal);
    color: var(--on-signal);
  }

  @media (max-width: 40rem) {
    .uses-map-popover {
      width: calc(100% - 1.5rem);
      padding: var(--space-2) var(--space-3) var(--space-3);
    }
  }
</style>
