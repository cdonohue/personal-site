---
import DeskScene from '../../pixel-desk/components/DeskScene'
import Link from '../../../components/Link.astro'
import Icon from '../components/Icon.astro'
import Layout from '../layouts/Layout.astro'
import { jobs } from '../../../content'

const current = jobs[0]
---

<Layout index="01">
  {/*
    The pixel scene is the screen's one big Display: unchanged inside, framed as
    the black LCD every Unit 01 screen is built around. client:only for the
    reasons in the pixel-desk page — it reads the visitor's clock and the
    weather on mount, so there is nothing to prerender.
  */}
  <section class="u-display stage" aria-label="Desk">
    <div class="u-display__row" aria-hidden="true">
      <span class="u-display__label">Desk</span>
      <span class="u-display__label u-display__label--extra">Houston</span>
      <span class="u-display__label">Live <span class="u-led is-lit"></span></span>
    </div>
    <DeskScene client:only="react" />
  </section>

  <div class="modules modules--2-1">
    <section class="u-panel" aria-labelledby="about-title">
      <header class="u-panel__head">
        <h2 class="u-label" id="about-title"><b>01</b> About</h2>
      </header>
      <div class="u-panel__body prose">
        <p class="lead">
          I work across design and engineering, focusing on the systems, interfaces, and frontend
          architecture that help ambitious products stay coherent as they grow.
        </p>
        <p>
          I’m especially interested in designing agentic processes that genuinely improve the work
          while keeping people in control and remaining clear, useful, and dependable.
        </p>
      </div>
    </section>

    <section class="u-panel" aria-labelledby="now-title">
      <header class="u-panel__head">
        <h2 class="u-label" id="now-title"><b>02</b> Now</h2>
        <span class="u-label">{String(jobs.length).padStart(2, '0')} roles</span>
      </header>
      <div class="u-panel__body">
        <div class="u-display now">
          <span class="u-display__label">{current.title}</span>
          <span class="now__company">
            {current.url ? <Link href={current.url}>{current.company}</Link> : current.company}
          </span>
        </div>
        <div class="keylist">
          <Link href="/experience" class="keyrow">
            <span class="keyrow__label">All experience</span>
            <Icon name="arrow-right" />
          </Link>
        </div>
      </div>
    </section>
  </div>
</Layout>
