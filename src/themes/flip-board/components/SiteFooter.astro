---
import { elsewhere } from '../../../content'
import Link from '../../../components/Link.astro'
---

<footer>
  <div data-board="split" data-space="2">
    <h2 data-tone="muted">Elsewhere</h2>
    <p>
      {
        elsewhere.map(({ label, href }) => (
          <>
            <Link href={href}>{label}</Link>{' '}
          </>
        ))
      }
    </p>
  </div>
</footer>
