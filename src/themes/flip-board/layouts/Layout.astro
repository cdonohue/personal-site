---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../styles.css'

interface Props {
  /** Appended to the site name in the tab. Omitted on the home page. */
  title?: string
  /** Page-specific summary for search results and link previews. */
  description?: string
}

const {
  title,
  description = 'Chad Donohue is a software engineer building thoughtful products, design systems, and frontend architecture.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `Chad Donohue — ${title}` : 'Chad Donohue'}</title>
    <script is:inline>
      /*
       * Before first paint: the stored light/dark choice, shared with the pixel
       * desk and Unit 01, and the flag that hands the page to the board.
       *
       * The board hides the source markup it is drawn from. If its script never
       * arrives, the flag comes off again and the plain page is left readable,
       * which beats an empty frame.
       */
      try {
        const stored = localStorage.getItem('desk-room.theme')
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored)
        }
      } catch {}
      const root = document.documentElement
      root.classList.add('fb-js')
      setTimeout(() => {
        if (!root.classList.contains('fb-ready')) root.classList.remove('fb-js')
      }, 4000)
    </script>
  </head>
  <body>
    <div class="fb-housing">
      <div class="fb-source" data-flip-source tabindex="-1">
        <SiteHeader />
        <main>
          <slot />
        </main>
        <SiteFooter />
      </div>
      <div class="fb-board" data-flip-board aria-hidden="true"></div>
    </div>
    <script>
      import '../board/main.ts'
    </script>
  </body>
</html>
