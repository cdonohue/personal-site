---
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles.css'

interface Props {
  /** Appended to the site name in the tab. Omitted on the home page. */
  title?: string
  /** Page-specific summary for search results and link previews. */
  description?: string
}

const {
  title,
  description = 'Chad Donohue is a software engineer building thoughtful products, design systems, and frontend architecture.',
} = Astro.props
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Tiny5&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `Chad Donohue — ${title}` : 'Chad Donohue'}</title>
    <script is:inline>
      /*
       * Before anything paints: the stored light/dark choice, and the flag
       * that hands the page text to the flap boards.
       *
       * The light switch that sets the theme lives in the hero island on the
       * home page, which does not exist on the other pages and does not run
       * until after first paint on this one. Without this, choosing dark and
       * then clicking through to Experience would flash light and correct
       * itself.
       *
       * Page changes swap the <html> attributes for the incoming page's, which
       * carry neither, so both are put back after every swap. This script runs
       * once per full load, and the listener lives on for the visit.
       *
       * If the board script never arrives, the flag comes off again and the
       * plain page is left readable, which beats empty space.
       *
       * is:inline keeps it out of the bundle: it has to be in the document, and
       * it has to run before the stylesheet has anything to apply.
       */
      const prepare = () => {
        const root = document.documentElement
        try {
          const stored = localStorage.getItem('desk-room.theme')
          if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored)
        } catch {}
        root.classList.add('flip-js')
        if (window.__flipReady) root.classList.add('flip-ready')
      }
      prepare()
      document.addEventListener('astro:after-swap', prepare)
      setTimeout(() => {
        if (!window.__flipReady) document.documentElement.classList.remove('flip-js')
      }, 4000)
    </script>
    {/*
      Page changes without a reload, so the flap boards survive them and only
      turn what changed. Pages are still real HTML files; this fetches the next
      one and swaps it in. The project explorers are not built on this layout,
      so going to one is an ordinary navigation.
    */}
    <ClientRouter />
  </head>
  <body>
    <div class="mx-auto w-full max-w-3xl px-6 py-12">
      <SiteHeader />
      <slot />
    </div>
    <script>
      import '../flip/mount.ts'
    </script>
  </body>
</html>
