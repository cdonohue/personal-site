---
import { navigation, siteName } from '../../../content'
import Link from '../../../components/Link.astro'
import FlipText from './FlipText.astro'

/**
 * The masthead, shared by every page, and the first of the two flap boards.
 *
 * The active nav item is derived from the current URL and marked with
 * aria-current, which both the stylesheet and the board key off: on the board
 * it is the one lit flap. Astro renders this on the server, so the state is in
 * the HTML itself rather than resolved after hydration.
 *
 * Its board is persisted across pages, and these rows are identical on every
 * page but for that lit item, so a page change turns those few flaps and
 * nothing else up here.
 *
 * Without JavaScript this is the plain masthead: name and nav side by side
 * from `sm` (640px), on a shared baseline and the dithered rule. The board
 * makes the same choice by itself, splitting the row when both fit.
 */

/** Trailing slashes vary by host and by how a link was written, so normalise. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

const isCurrent = (to: string, end?: boolean) => {
  const target = to.replace(/\/+$/, '') || '/'
  return end ? path === target : path === target || path.startsWith(`${target}/`)
}
---

<header data-role="masthead" class="mb-12">
  <FlipText name="masthead">
    <div data-board="split" data-space="0" class="sm:flex sm:items-baseline sm:justify-between">
      <h1 data-role="site-name" class="mb-8 sm:mb-0">
        <Link href="/" data-tone="ink">{siteName}</Link>
      </h1>
      <nav class="flex gap-8">
        {
          navigation.map(({ label, to, end }) => (
            <>
              <Link
                href={to}
                data-tone="muted"
                aria-current={isCurrent(to, end) ? 'page' : undefined}
              >
                {label}
              </Link>{' '}
            </>
          ))
        }
      </nav>
    </div>
  </FlipText>
</header>
