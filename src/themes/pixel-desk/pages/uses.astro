---
import Layout from '../layouts/Layout.astro'
import Link from '../../../components/Link.astro'
import { useCategories, usesItems } from '../../../content'

const groups = useCategories.map((category) => ({
  category,
  items: usesItems.filter((item) => item.category === category),
}))
---

<Layout title="Uses" description="The hardware in Chad Donohue’s workspace.">
  <section class="mb-16">
    <h2 data-role="page-title" class="mb-10">Uses</h2>
    <div class="space-y-12">
      {
        groups.map(({ category, items }) => (
          <section>
            <h3 data-role="section-label" class="text-muted mb-6">
              {category}
            </h3>
            <div class="space-y-6 border-t border-line pt-6">
              {items.map((item) => (
                <Link href={item.href} class="group block">
                  <h4 data-role="item-title" class="mb-1">
                    {item.name} <span aria-hidden="true" class="text-muted">↗</span>
                  </h4>
                  <p class="text-muted leading-relaxed">{item.description}</p>
                </Link>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
