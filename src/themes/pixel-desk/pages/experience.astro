---
import Layout from '../layouts/Layout.astro'
import Link from '../../../components/Link.astro'
import { jobs } from '../../../content'
---

<Layout
  title="Experience"
  description="Chad Donohue’s experience building product infrastructure, design systems, and customer-facing software."
>
  <section class="mb-16">
    {/*
      This page used to go straight from the site name to job titles with
      nothing in between, so the list of roles was never announced as anything.
      Visually quiet, structurally the thing that makes the headings below a
      subsection rather than a second run of top-level ones.
    */}
    <h2 data-role="section-label" class="text-muted mb-4">Experience</h2>
    <p class="text-muted mb-10 max-w-2xl leading-relaxed">
      I build software across fintech, education, healthcare, and web design. The common thread is
      foundational product work: the systems that make the next feature easier to build and the
      whole product easier to understand.
    </p>

    {/*
      The company is a detail of the role rather than a heading under it: as an
      h4 it implied the description belonged to the company.
    */}
    <div class="space-y-10">
      {
        jobs.map((job) => (
          <article class="space-y-1">
            <h3 data-role="item-title">{job.title}</h3>
            <p data-role="item-meta" class="text-muted">
              {
                job.url ? (
                  <Link href={job.url}>{job.company}</Link>
                ) : (
                  job.company
                )
              }
            </p>
            <p class="pt-2 leading-relaxed">{job.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
