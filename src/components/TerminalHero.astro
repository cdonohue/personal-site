---
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<div class="terminal">
  {lines.map((line, index) => (
    <div
      class="terminal-line"
      style={`--line-index: ${index}; --char-count: ${line.length}`}
    >
      <span class="prompt">$</span>
      <span class="text">{line}</span>
    </div>
  ))}
  <div class="terminal-line cursor-line" style={`--line-index: ${lines.length}`}>
    <span class="prompt">$</span>
    <span class="cursor"></span>
  </div>
</div>

<style>
  .terminal {
    font-family: var(--font-mono);
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-container);
    width: 100%;
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: 0.75em;
    margin-bottom: 0.5em;
    opacity: 0;
    animation: fadeIn 0.1s ease forwards;
    animation-delay: calc(var(--line-index) * 1.5s + 0.5s);
  }

  .prompt {
    color: var(--accent);
    font-weight: 500;
    flex-shrink: 0;
  }

  .text {
    color: var(--text-primary);
    overflow: hidden;
    white-space: nowrap;
    animation: typing 1s steps(var(--char-count), end) forwards;
    animation-delay: calc(var(--line-index) * 1.5s + 0.5s);
    max-width: 0;
    line-height: var(--leading-normal);
  }

  .cursor-line {
    opacity: 0;
    animation: fadeIn 0.1s ease forwards;
    animation-delay: calc(var(--line-index) * 1.5s + 0.5s);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--accent);
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  @keyframes typing {
    to {
      max-width: 100%;
    }
  }

  @keyframes blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Mobile: full bleed, no rounded corners */
  @media (max-width: 480px) {
    .terminal {
      border-radius: 0;
      margin-left: calc(-1 * var(--space-container));
      margin-right: calc(-1 * var(--space-container));
      width: calc(100% + var(--space-container) * 2);
    }

    .text {
      white-space: normal;
      animation: none;
      max-width: 100%;
    }

    .terminal-line {
      animation-delay: calc(var(--line-index) * 0.3s);
    }
  }
</style>
