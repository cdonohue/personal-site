---
interface Props {
  level?: 1 | 2 | 3 | 4;
  size?: 'base' | 'lg';
  weight?: 'normal' | 'medium';
  muted?: boolean;
  class?: string;
}

const {
  level = 1,
  size = 'base',
  weight = 'medium',
  muted = false,
  class: className = ''
} = Astro.props;

const Tag = `h${level}` as any;
---

<Tag class:list={[`heading heading--${size} heading--${weight}`, { 'heading--muted': muted }, className]}>
  <slot />
</Tag>

<style is:global>
  .heading {
    margin: 0;
    color: var(--text-primary);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .heading--base { font-size: var(--text-base); }
  .heading--lg { font-size: var(--text-lg); }

  .heading--normal { font-weight: 400; }
  .heading--medium { font-weight: 500; }

  .heading--muted {
    color: var(--text-muted);
  }
</style>
