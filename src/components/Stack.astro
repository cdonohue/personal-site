---
interface Props {
  gap?: 'micro' | 'tight' | 'standard' | 'container' | 'layout' | 'section';
  class?: string;
}

const { gap = 'standard', class: className = '' } = Astro.props;
---

<div class:list={[`stack stack--${gap}`, className]}>
  <slot />
</div>

<style is:global>
  .stack {
    display: flex;
    flex-direction: column;
  }

  .stack--micro { gap: var(--space-micro); }
  .stack--tight { gap: var(--space-tight); }
  .stack--standard { gap: var(--space-standard); }
  .stack--container { gap: var(--space-container); }
  .stack--layout { gap: var(--space-layout); }
  .stack--section { gap: var(--space-section); }
</style>
