---
import Center from './Center.astro';
import Text from './Text.astro';
import Link from './Link.astro';
---

<footer>
  <Center maxWidth="var(--container-md)" gutter="var(--space-container)">
    <div class="footer-content">
      <Text size="sm" muted maxWidth="none">© {new Date().getFullYear()} Chad Donohue</Text>
      <div class="footer-links">
        <Link href="https://github.com/cdonohue" variant="nav" size="sm" muted external>GitHub</Link>
        <Link href="https://linkedin.com/in/chaddonohue" variant="nav" size="sm" muted external>LinkedIn</Link>
        <Link href="https://twitter.com/chaddonohue" variant="nav" size="sm" muted external>Twitter</Link>
      </div>
    </div>
  </Center>
</footer>

<style is:global>
  footer {
    margin-top: var(--space-section);
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-tight);
    padding-block: var(--space-layout);
    border-top: 1px solid var(--border);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-standard);
  }
</style>
