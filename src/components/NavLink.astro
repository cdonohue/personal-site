---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<a href={href} class={`nav-link ${className}`}>
  <slot />
</a>

<style>
  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-base);
    transition: color var(--transition-base);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }
</style>
