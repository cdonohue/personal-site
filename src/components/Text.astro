---
interface Props {
  size?: 'sm' | 'base' | 'lg';
  weight?: 'normal' | 'medium';
  maxWidth?: string;
  muted?: boolean;
  class?: string;
}

const {
  size = 'base',
  weight = 'normal',
  maxWidth = '65ch',
  muted = false,
  class: className = ''
} = Astro.props;
---

<p class:list={[`text text--${size} text--${weight}`, { 'text--muted': muted }, className]} style={`max-width: ${maxWidth};`}>
  <slot />
</p>

<style is:global>
  .text {
    margin: 0;
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .text--sm { font-size: var(--text-sm); }
  .text--base { font-size: var(--text-base); }
  .text--lg { font-size: var(--text-lg); }

  .text--normal { font-weight: 400; }
  .text--medium { font-weight: 500; }

  .text--muted {
    color: var(--text-muted);
  }
</style>
