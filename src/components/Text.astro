---
interface Props {
  as?: 'p' | 'span' | 'div';
  size?: 'xs' | 'sm' | 'base' | 'lg';
  weight?: 'light' | 'normal' | 'medium';
  leading?: 'tight' | 'normal' | 'relaxed';
  maxWidth?: string;
  muted?: boolean;
  class?: string;
}

const {
  as: Tag = 'p',
  size = 'base',
  weight = 'normal',
  leading = 'normal',
  maxWidth = 'var(--content-width)',
  muted = false,
  class: className = ''
} = Astro.props;
---

<Tag
  class:list={[
    'text',
    `text--${size}`,
    `text--${weight}`,
    `text--leading-${leading}`,
    { 'text--muted': muted },
    className
  ]}
  style={maxWidth !== 'none' ? `max-width: ${maxWidth};` : undefined}
>
  <slot />
</Tag>

<style is:global>
  .text {
    margin: 0;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* Size variants */
  .text--xs { font-size: var(--text-xs); }
  .text--sm { font-size: var(--text-sm); }
  .text--base { font-size: var(--text-base); }
  .text--lg { font-size: var(--text-lg); }

  /* Weight variants */
  .text--light { font-weight: var(--font-light); }
  .text--normal { font-weight: var(--font-normal); }
  .text--medium { font-weight: var(--font-medium); }

  /* Line height variants */
  .text--leading-tight { line-height: var(--leading-tight); }
  .text--leading-normal { line-height: var(--leading-normal); }
  .text--leading-relaxed { line-height: var(--leading-relaxed); }

  /* Muted variant */
  .text--muted {
    color: var(--text-muted);
  }
</style>
