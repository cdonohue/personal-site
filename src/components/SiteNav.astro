---
import Link from './Link.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname === `${href}/`;
---

<nav>
  <Link href="/" variant="nav">CD</Link>
  <div class="nav-links">
    <Link href="/work" variant="nav" muted={!isActive('/work')}>Work</Link>
  </div>
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-tight);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-standard);
  }
</style>
