---
import SiteHeader from '../components/SiteHeader.astro'
import '../index.css'

interface Props {
  /** Appended to the site name in the tab. Omitted on the home page. */
  title?: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Tiny5&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `Chad Donohue — ${title}` : 'Chad Donohue'}</title>
  </head>
  <body>
    <div class="mx-auto w-full max-w-3xl px-6 py-12">
      <SiteHeader />
      <slot />
    </div>
  </body>
</html>
