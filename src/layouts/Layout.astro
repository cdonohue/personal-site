---
import SiteHeader from '../components/SiteHeader.astro'
import '../index.css'

interface Props {
  /** Appended to the site name in the tab. Omitted on the home page. */
  title?: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Tiny5&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `Chad Donohue — ${title}` : 'Chad Donohue'}</title>
    <script is:inline>
      /*
       * Apply a stored theme before anything paints.
       *
       * The light switch that sets it lives in the hero island on the home
       * page, which does not exist on the other two and does not run until
       * after first paint on this one. Without this, choosing dark and then
       * clicking through to Experience would flash light and correct itself.
       *
       * is:inline keeps it out of the bundle: it has to be in the document, and
       * it has to run before the stylesheet has anything to apply.
       */
      try {
        const stored = localStorage.getItem('desk-room.theme')
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored)
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="mx-auto w-full max-w-3xl px-6 py-12">
      <SiteHeader />
      <slot />
    </div>
  </body>
</html>
